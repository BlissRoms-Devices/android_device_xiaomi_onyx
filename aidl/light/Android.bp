cc_binary {
    name: "android.hardware.light-service.onyx",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.light-service.onyx.rc"],
    vintf_fragments: ["android.hardware.light-service.onyx.xml"],
    srcs: [
        "models/Color.cpp",
        "models/State.cpp",
        "Devices.cpp",
        "Lights.cpp",
        "Utils.cpp",
        "service.cpp",
    ],
    local_include_dirs: ["."],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.light-V2-ndk",
    ],
}
