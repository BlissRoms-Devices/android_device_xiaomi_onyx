type vendor_lowi_server, domain;
type vendor_xtra_daemon, domain;

# Allow loc_launcher to transition to them
domain_auto_trans(vendor_location, vendor_location_lowi_server_exec, vendor_lowi_server)
domain_auto_trans(vendor_location, vendor_location_xtra_daemon_exec, vendor_xtra_daemon)

# Allow lowi-server & xtra-daemon to use file descriptors
allow vendor_lowi_server vendor_location:fd use;
allow vendor_xtra_daemon vendor_location:fd use;
